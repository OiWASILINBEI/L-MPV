{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "L-MPV",
  "version": "../package.json",
  "identifier": "com.lmpv.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "L-MPV",
        "width": 1280,
        "height": 720,
        "minWidth": 560,
        "minHeight": 180,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "mediainfo",
        "create": false,
        "title": "L-MPV MediaInfo",
        "width": 655,
        "height": 685,
        "minWidth": 460,
        "minHeight": 360,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer_hooks.nsh",
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": true
      },
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "resources": {
      "binaries/libmpv-2.dll": "libmpv-2.dll",
      "binaries/ffmpeg.exe": "ffmpeg.exe",
      "binaries/mediainfo.dll": "mediainfo.dll",
      "../bundled/portable-assets/config/scripts": "config/scripts",
      "../bundled/portable-assets/config/script-modules/startup-logo-bounds.lua": "config/script-modules/startup-logo-bounds.lua",
      "../bundled/portable-assets/config/script-opts/startup_format_logos.conf": "config/script-opts/startup_format_logos.conf",
      "../bundled/portable-assets/config/script-opts/stats.conf": "config/script-opts/stats.conf",
      "../bundled/portable-assets/config/fonts/NotoSansCJK-Bold.ttc": "config/fonts/NotoSansCJK-Bold.ttc",
      "../bundled/yt-dlp/yt-dlp.exe": "config/yt-dlp.exe",
      "../bundled/portable-assets/config/script-assets": "config/script-assets"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
